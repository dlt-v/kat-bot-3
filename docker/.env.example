# KatBot .env example
# Copy to .env and fill in real values before running.

# Discord bot token (required)
token=YOUR_DISCORD_BOT_TOKEN

# Database settings (for local docker-compose or external DB)
DB_URL=jdbc:postgresql://db:5432/katbot_db
DB_USERNAME=katbot_user
DB_PASSWORD=change_me
DB_SCHEMA=public
DB_NAME=katbot_db

# Runtime environment: 'testing' or 'production'
environment=production

# IDs used for testing and footers
testing-channel-id=123456789012345678
testing-user-id=123456789012345678

# Optional: human-readable version string shown in help/about
version=1.0.0
